# ===========================================================================
# DEV ONLY — these are NOT the production secrets.
#
# The production credentials come from the Ansible defaults / Vault
# (heriverse-ansible), never from this repository. Everything here is a value
# chosen so a laptop stack comes up without a decision, and every one of them
# would be a vulnerability on anything reachable.
#
#   cp .env.dev.example .env.dev      # then edit only if a port collides
# ===========================================================================

# --- object store ----------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=em-assets
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- identity --------------------------------------------------------------
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
# 8080 is a busy port on a developer's machine (this one already had a Moodle on
# it), so the dev stack does not claim it. Change it here if 8085 is taken too.
KEYCLOAK_PORT=8085
# Seeded by keycloak/realm-em-dev.json — change them there, not only here.
DEV_REALM=em-dev
DEV_CLIENT_ID=em-server
DEV_CLIENT_SECRET=em-dev-secret
DEV_USER=dev
DEV_PASSWORD=dev

# --- images (IIIF) ----------------------------------------------------------
# Cantaloupe reads the SAME bucket, with the asset's sha256 as the identifier.
CANTALOUPE_PORT=8182

# ── the field assistant ──────────────────────────────────────────────────────
# By default it writes to its OWN container on a volume — no room, no token. It
# refuses to start with a room and no token, and a JWT does not belong in a file
# that outlives the reason it was issued, so these stay empty here.
# To point it at a room, pass a FRESH token for that run — see CHEATSHEET §1-ter.
# EM_CHATBOT_SERVER_URL=http://stratigraph-server:8000
# EM_CHATBOT_ROOM=cantiere-demo
# EM_CHATBOT_TOKEN=            # never fill this in: `EM_CHATBOT_TOKEN="$(./token.sh)" docker compose up -d …`
EM_CHATBOT_STUDY=Scavo

# ── where the tools' WEB builds live ─────────────────────────────────────────
# Set one and the room browser grows a "browser" door for that tool beside the
# desktop one: a tab at `<web>?server=&room=`, carrying no token — the web build
# does its own OIDC (possible without mixed content since Keycloak moved behind
# https). Leave one empty and that tool simply has no browser door.
#
# Empty by default: a door to a dev server nobody is running is exactly the
# after-the-click failure this replaces. Uncomment when the builds are up.
# EM_EMSTUDIO_WEB_URL=http://localhost:5177
# EM_FIELD_ASSISTANT_URL=http://localhost:8020

# ── the photogrammetric engine ───────────────────────────────────────────────
# OPT-IN: the engine is behind the `engine` compose profile, so a plain
# `./fcn-up.sh` leaves it down. Turn it on for a photogrammetry session:
#   docker compose --env-file .env.dev -f docker-compose.dev.yml \
#     --profile engine up -d nodeodm
#
# NodeODM's own dashboard, for a developer watching a run. StratiGraph Server does
# NOT use this port: it dials `http://nodeodm:3000` on the compose network.
NODEODM_PORT=3010
# Minutes before the engine deletes a FINISHED, FAILED or CANCELED task and its
# archive (NodeODM's own `--cleanup_tasks_after`; its default is 2880 = 48 h,
# which is what filled a 19 GB disk here). Safe to keep short: the connector
# publishes the produced bytes to MinIO before it writes anything to the graph,
# so what we keep is in the object store. Raise it if somebody re-downloads runs
# from NodeODM's dashboard.
NODEODM_CLEANUP_AFTER=60
# Minutes before an INTERRUPTED upload is dropped. A different question — it is
# "the longest a cluster takes to upload", not how long to keep results.
NODEODM_CLEANUP_UPLOADS_AFTER=60

# --- https (profile `https`) -------------------------------------------------
# The dev stack's front door, the same shape as the production one: one host,
# TLS, routes by path. 8443 rather than 443 because 443 needs root.
EM_DEV_DOMAIN=em.localhost
HTTPS_PORT=8443

# ── this node's own PUBLIC address ───────────────────────────────────────────
# What a HANDOFF link names (`stratigraph://open?server=…`), so another machine
# can follow it. Configuration and never a request header: a link built from
# `Host` is a link an attacker can aim by asking for it with the right one. With
# this unset the node REFUSES to write a link (503 with a sentence) rather than
# naming localhost — which would only work on the machine that wrote it.
EM_PUBLIC_BASE=https://em.localhost:8443/em

# --- the catalog ------------------------------------------------------------
# em-catalog serves the STUDIES (em.json containers) beside em-server's rooms,
# out of the SAME bucket under the `studies/` prefix and against the SAME realm.
EM_CATALOG_PORT=8010
# Where EMStudio lives, for the "open in…" deep links. Only used to WRITE a URL
# into an answer — the catalogue never dials it.
EM_CATALOG_EMSTUDIO_URL=http://localhost:5173
# The DEPLOY index (profile `couchdb`). Unset → the dev index is SQLite; set →
# CouchDB is used. Never chosen silently, in either direction.
COUCHDB_USER=admin
COUCHDB_PASSWORD=admin
# 5984 is CouchDB's own port and a developer's machine may well already have one
# on it (this one did: a Heriverse CouchDB, up for weeks). The dev stack does not
# claim it — the same courtesy KEYCLOAK_PORT pays to the Moodle on 8080.
COUCHDB_PORT=5985

# --- the room ---------------------------------------------------------------
EM_SERVER_PORT=8000
# What EMStudio and the manifests should use as the IIIF Image API base — the
# PUBLIC form. In the dev stack that is Cantaloupe on localhost; behind Caddy in
# production it is https://<host>/iiif/3. em-server also has an INTERNAL form
# (the compose service name), set in the compose file: see docs/URL-TOPOLOGY.md.
EM_IIIF_PUBLIC=http://localhost:8182/iiif/3
