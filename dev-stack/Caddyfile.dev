# The dev stack's HTTPS front door — deliberately the SAME SHAPE as production.
#
# `heriverse-ansible/role/templates/Caddyfile.j2` terminates TLS on one host and
# reverse-proxies by path to service names on the internal network. This file
# does the same thing on `em.localhost`, so what is exercised here is the
# arrangement that will run on the institutional host: one origin for the app,
# the room, the images and the assets — which is what removes mixed-content and
# makes a token in a query defensible.
#
# The certificate is issued by Caddy's INTERNAL CA (`tls internal`). Trusting it
# is a step for a human with a password — see README-DEV. Until then `curl
# --cacert` works and browsers do not, and that boundary is the honest state of
# a local https: the real answer is a public certificate on a real host.

{
	# a local CA, not ACME: there is nothing public to validate here
	local_certs
	auto_https disable_redirects
}

{$EM_SITE:https://em.localhost} {
	tls internal

	# StratiGraph · the room (graph + assets + the WebSocket the editors join).
	# `handle_path` strips `/em`, because StratiGraph Server serves `/v1/...` at its
	# root. The `/em` PATH stays: it is a public address, not the repo's name.
	handle_path /em/* {
		reverse_proxy stratigraph-server:8000
	}

	# StratiGraph · the FIELD ASSISTANT — and the reason it is here at all is a
	# browser rule, not a preference: camera, microphone and GPS are offered
	# only to a secure context. On a laptop `http://localhost:8020` counted as
	# one; on a PHONE it does not, so the assistant ran without the three things
	# it exists for. Behind this door it is https on the shared origin, and they
	# come back.
	#
	# `handle_path` — which STRIPS — and that is the opposite of the two routes
	# below it. The distinction the rest of this file keeps warning about, so
	# here is which side this one is on and why:
	#
	#   · the Catalog serves `/catalog/...` at its own root, and IIIF carries its
	#     API version in the path. For them the prefix IS part of the endpoint,
	#     so stripping it would take the route with it → `handle`.
	#   · the assistant serves `/`, `/v1/...`, `/sw.js` and `/brand/...` at its
	#     root, exactly like the room server. It knows nothing about `/chat`, so
	#     the prefix has to come off → `handle_path`.
	#
	# The PAGE is what makes this safe: it derives its API base and its service
	# worker from its own document URL (`web/index.html`, `web/sw.js`), so the
	# same file works served here at `/chat/` and at `:8020/` for the `--reload`
	# loop. A worker registered at the origin's root would claim scope `/` and
	# intercept the fetches of every service above.
	handle_path /chat/* {
		reverse_proxy stratigraph-chatbot:8000
	}

	# StratiGraph · the CATALOG (studies as published, beside the rooms above).
	# `handle` and NOT `handle_path`: StratiGraph Catalog serves `/catalog/...` at its
	# root, so the prefix is part of the endpoint and stripping it would take
	# the route with it — the same distinction as `/iiif` below, and the same
	# trap.
	handle /catalog/* {
		reverse_proxy stratigraph-catalog:8000
	}

	# The IIIF Image API. `handle` and NOT `handle_path`: the API version lives
	# in the path (`/iiif/3/...`), so stripping the prefix would take the
	# endpoint with it.
	#
	# EMBARGO · every image request is authorised by StratiGraph Server FIRST.
	#
	# Cantaloupe reads the bucket by sha256 and the server is not in the path of
	# a pixel: taking the canvas out of a manifest withholds the digest, but
	# whoever already has the hex reaches the image directly. So the proxy asks
	# — `forward_auth` to `/v1/iiif-authz`, which reads the graph, resolves the
	# room's roles and applies the SAME rule the asset route applies (editor and
	# above may see an embargoed image; nobody else may).
	#
	# `X-Forwarded-Uri` is what carries the identifier: the sub-request goes to
	# a fixed path, so the original one has to travel in a header. `copy_headers
	# X-EM-Authz` brings the decision back for anybody debugging it.
	#
	# Chosen over a Cantaloupe DELEGATE script (Ruby, calling back here): a
	# delegate puts a second implementation of the rule in a second language,
	# inside a component whose job is not authorisation, and hides it from the
	# file people actually read when they ask who can reach what.
	handle /iiif/* {
		forward_auth stratigraph-server:8000 {
			uri /v1/iiif-authz
			copy_headers X-EM-Authz
		}
		reverse_proxy cantaloupe:8182
	}

	# The object store, for clients that fetch an asset by its digest.
	handle_path /assets/* {
		reverse_proxy minio:9000
	}

	# Identity, on the same origin as everything else.
	handle /auth/* {
		reverse_proxy keycloak:8080
	}

	handle {
		respond "em dev stack — try /em/v1/health, /catalog/health, /iiif/3/<sha256>/info.json" 200
	}
}
