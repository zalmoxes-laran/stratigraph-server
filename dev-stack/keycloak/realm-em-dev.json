{
  "realm": "em-dev",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "accessTokenLifespan": 3600,
  "clients": [
    {
      "clientId": "em-server",
      "name": "em-server (dev)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "em-dev-secret",
      "serviceAccountsEnabled": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "fullScopeAllowed": true,
      "attributes": {
        "access.token.lifespan": "3600"
      },
      "protocolMappers": [
        {
          "name": "audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "em-server",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "orcid",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "orcid",
            "claim.name": "orcid",
            "jsonType.label": "String",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "em-console",
      "name": "em-server node console (browser, PKCE)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": true,
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "access.token.lifespan": "900"
      },
      "redirectUris": [
        "http://localhost:8000/admin/*",
        "http://127.0.0.1:8000/admin/*",
        "https://em.localhost:8443/em/admin/*",
        "https://localhost:8443/em/admin/*",
        "http://localhost:8000/rooms/*",
        "http://127.0.0.1:8000/rooms/*",
        "https://em.localhost:8443/em/rooms/*",
        "https://localhost:8443/em/rooms/*",
        "http://localhost:8000/work/*",
        "http://127.0.0.1:8000/work/*",
        "https://em.localhost:8443/em/work/*",
        "https://localhost:8443/em/work/*",
        "http://localhost:8000/tools/*",
        "http://127.0.0.1:8000/tools/*",
        "https://em.localhost:8443/em/tools/*",
        "https://localhost:8443/em/tools/*",
        "http://localhost:8020/*",
        "http://127.0.0.1:8020/*",
        "https://em.localhost:8443/chat/*",
        "https://localhost:8443/chat/*",
        "https://em.localhost:8443/em/studio/*",
        "https://localhost:8443/em/studio/*",
        "https://em.localhost:8443/em/read/*",
        "https://localhost:8443/em/read/*",
        "http://localhost:5173/*",
        "http://127.0.0.1:5173/*",
        "http://localhost:8090/*",
        "http://127.0.0.1:8090/*",
        "https://em.localhost:8443/pyarchinit/*",
        "https://localhost:8443/pyarchinit/*"
      ],
      "webOrigins": [
        "+"
      ],
      "protocolMappers": [
        {
          "name": "audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "em-server",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "audience-chatbot",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "em-chatbot",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "orcid",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "orcid",
            "claim.name": "orcid",
            "jsonType.label": "String",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "dev",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Dev",
      "lastName": "User",
      "email": "dev@em.local",
      "attributes": {
        "orcid": [
          "0000-0002-1825-0097"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "dev",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-em-dev"
      ]
    },
    {
      "username": "viewer",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Viewer",
      "lastName": "User",
      "email": "viewer@em.local",
      "attributes": {
        "orcid": [
          "0000-0001-5109-3700"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "viewer",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-em-dev"
      ]
    }
  ]
}
